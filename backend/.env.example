# ── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/astamami_db"

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_at_least_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@astamami.com

# ── File Storage (Local in Dev) ───────────────────────────
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads

# ── Cloudflare R2 (Production) ────────────────────────────
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=astamami-files
# R2_PUBLIC_URL=https://files.astamami.com

# ── Frontend URL (CORS) ────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Bcrypt ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
